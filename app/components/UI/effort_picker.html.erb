<div id="<%= UI::EffortPicker::DOM_ID %>">
  <% if locked? %>
    <span class="text-xs text-secondary px-1.5" title="<%= t("messages.chat_form.effort_locked") %>">
      <%= selected_label %>
    </span>
  <% else %>
    <%= render DS::Menu.new(variant: :button, placement: placement) do |menu| %>
      <% menu.with_button(
           type: "button",
           class: "inline-flex items-center gap-1 bg-container border border-secondary font-medium rounded-lg pl-2.5 pr-1.5 py-1 text-xs cursor-pointer text-primary hover:bg-container-inset-hover focus:outline-hidden focus:ring-0",
           aria: { label: t("messages.chat_form.effort_aria", depth: selected_label) }
         ) do %>
        <span class="whitespace-nowrap"><%= selected_label %></span>
        <%= helpers.icon("chevron-down", size: "sm") %>
      <% end %>

      <% levels.each do |level| %>
        <% menu.with_item(
             variant: :link,
             text: label_for(level),
             href: href_for(level),
             selected: selected?(level),
             data: { turbo_method: :patch }
           ) %>
      <% end %>
    <% end %>
  <% end %>
</div>
